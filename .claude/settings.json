{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format && uv run ruff check --fix && uv run ty check && uv run pytest --quiet --tb=line || { echo 'Quality checks failed - fix issues before completing' >&2; exit 2; }"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(agent-browser close:*)",
      "Bash(agent-browser open:*)",
      "Bash(agent-browser screenshot:*)",
      "Bash(gh run list:*)",
      "Bash(just format-check:*)",
      "Bash(just format:*)",
      "Bash(just lint-fix:*)",
      "Bash(just lint:*)",
      "Bash(just pre-commit:*)",
      "Bash(just qa)",
      "Bash(just test-cov:*)",
      "Bash(just test:*)",
      "Bash(just type-check:*)",
      "Bash(tree:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(uv run smk:*)",
      "Skill(agent-browser)",
      "Skill(git)",
      "Skill(python-package-management)",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ]
  }
}
